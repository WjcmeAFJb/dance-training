{
  "name": "dance-training",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive Kakoune learning tool that adapts to your VS Code Dance keybindings.",
  "homepage": "https://daniil.pl/dance-training/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsgo --noEmit && vite build",
    "preview": "vite preview --port 5174",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm lessons:validate && pnpm test",
    "lessons:validate": "tsx scripts/validate-lessons.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "marked": "^16.0.0",
    "monaco-editor": "^0.54.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "wouter": "^3.5.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tailwindcss/vite": "^4.0.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript/native-preview": "^7.0.0-dev.20260502.1",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^26.0.0",
    "lucide-react": "^0.475.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
